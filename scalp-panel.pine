//@version=6
indicator("Scalp Panel [Claude]", overlay = true, max_boxes_count = 60)

equity  = input.float(200,  "Portföy ($)")
riskPct = input.float(3.0,  "İşlem başı max kayıp %") / 100
minRR   = input.float(2.0,  "Min net R:R")
feePct  = input.float(0.05, "Taker komisyon % (tek yön)") / 100
vwmaLen = input.int(20,     "HAHO (VWMA) uzunluk")
rsiLen  = input.int(14,     "RSI uzunluk")
pv      = input.int(3,      "Pivot sol/sağ bar")
fresh   = input.int(10,     "Uyumsuzluk tazeliği (o TF'nin barı)")
tol     = input.float(0.05, "Temas toleransı %") / 100
swLen   = input.int(5,      "P/D swing pivot (giriş bölgesinin TF'i, sol/sağ bar)")
keyTol  = input.float(0.10, "Bölge–likidite yakınlık toleransı %") / 100
bosLen  = input.int(3,      "BOS swing pivot (5m, sol/sağ bar)")
bosFresh = input.int(24,    "BOS tazeliği (5m bar)")

touch(v, i) => low[i] <= v[i] * (1 + tol) and high[i] >= v[i] * (1 - tol)
inZ(t, b) => not na(t) and low <= t and high >= b
arrow(d) => d == 1 ? "↑" : d == -1 ? "↓" : "→"
pct(x) => (x >= 0 ? "+" : "") + str.tostring(x * 100, "#.##") + "%"
px(x) => str.tostring(x, format.mintick)

// Adım 1 — trend: fiyat > EMA50 > EMA200 (veya tersi)
trendF() =>
    e50  = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    close > e50 and e50 > e200 ? 1 : close < e50 and e50 < e200 ? -1 : 0

// Adım 2 — HAHO (VWMA) teması: bu veya önceki mum
hahoF() =>
    v = ta.vwma(close, vwmaLen)
    [v, touch(v, 0) or touch(v, 1)]

// Adım 3 — klasik RSI uyumsuzluğu (pivot tabanlı)
divF() =>
    r  = ta.rsi(close, rsiLen)
    ph = ta.pivothigh(high, pv, pv)
    pl = ta.pivotlow(low, pv, pv)
    var float pH = na
    var float rH = na
    var float pL = na
    var float rL = na
    var int dir = 0
    var int at = na
    if not na(ph)
        if not na(pH) and ph > pH and r[pv] < rH
            dir := -1
            at := bar_index
        else if dir == -1
            // yeni tepe uyumsuzluk oluşturmadı → eski ayı uyumsuzluğu geçersiz
            dir := 0
        pH := ph
        rH := r[pv]
    if not na(pl)
        if not na(pL) and pl < pL and r[pv] > rL
            dir := 1
            at := bar_index
        else if dir == 1
            // yeni dip uyumsuzluk oluşturmadı → eski boğa uyumsuzluğu geçersiz
            dir := 0
        pL := pl
        rL := r[pv]
    // Fiyat uyumsuzluğun tepesini (dibini) kapanışla aşarsa uyumsuzluk geçersiz
    if dir == -1 and close > pH
        dir := 0
    if dir == 1 and close < pL
        dir := 0
    [dir, bar_index - at]

// Yalnızca kapanmış mumlar: bir önceki (kapanmış) HTF mumundaki durum; yaş şimdiki muma göre +1
divClosed() =>
    [d, a] = divF()
    [d[1], a[1] + 1]

// Adım 4 — ICT: son FVG / IFVG / OB ve fiyat içinde mi
zonesF() =>
    var float bfT = na
    var float bfB = na
    var float sfT = na
    var float sfB = na
    var float biT = na
    var float biB = na
    var float siT = na
    var float siB = na
    var float boT = na
    var float boB = na
    var float soT = na
    var float soB = na
    var int bfX = na
    var int sfX = na
    var int biX = na
    var int siX = na
    var int boX = na
    var int soX = na
    if low > high[2]
        bfT := low
        bfB := high[2]
        bfX := time[2]
        if close[2] < open[2]
            boT := high[2]
            boB := low[2]
            boX := time[2]
    if high < low[2]
        sfT := low[2]
        sfB := high
        sfX := time[2]
        if close[2] > open[2]
            soT := high[2]
            soB := low[2]
            soX := time[2]
    // kapanışla kırılan FVG ters yönde IFVG olur
    if not na(bfB) and close < bfB
        siT := bfT
        siB := bfB
        siX := bfX
        bfT := na
        bfB := na
    if not na(sfT) and close > sfT
        biT := sfT
        biB := sfB
        biX := sfX
        sfT := na
        sfB := na
    if not na(biB) and close < biB
        biT := na
        biB := na
    if not na(siT) and close > siT
        siT := na
        siB := na
    if not na(boB) and close < boB
        boT := na
        boB := na
    if not na(soT) and close > soT
        soT := na
        soB := na
    bull = (inZ(bfT, bfB) ? "FVG " : "") + (inZ(biT, biB) ? "iFVG " : "") + (inZ(boT, boB) ? "OB" : "")
    bear = (inZ(sfT, sfB) ? "FVG " : "") + (inZ(siT, siB) ? "iFVG " : "") + (inZ(soT, soB) ? "OB" : "")
    bSL = math.min(inZ(bfT, bfB) ? bfB : 1e12, inZ(biT, biB) ? biB : 1e12, inZ(boT, boB) ? boB : 1e12)
    sSL = math.max(inZ(sfT, sfB) ? sfT : 0.0, inZ(siT, siB) ? siT : 0.0, inZ(soT, soB) ? soT : 0.0)
    [bull, bear, bSL, sSL, bfT, bfB, bfX, sfT, sfB, sfX, biT, biB, biX, siT, siB, siX, boT, boB, boX, soT, soB, soX]

// lookahead_on: son barda oluşan (canlı) HTF mumu okunur. Panel yalnızca son barı kullanır, geçmiş barlar önemsiz.
t1 = request.security(syminfo.tickerid, "60",  trendF(), lookahead = barmerge.lookahead_on)
t4 = request.security(syminfo.tickerid, "240", trendF(), lookahead = barmerge.lookahead_on)
tD = request.security(syminfo.tickerid, "D",   trendF(), lookahead = barmerge.lookahead_on)
[v1, h1] = request.security(syminfo.tickerid, "60",  hahoF(), lookahead = barmerge.lookahead_on)
[v4, h4] = request.security(syminfo.tickerid, "240", hahoF(), lookahead = barmerge.lookahead_on)
[vD, hD] = request.security(syminfo.tickerid, "D",   hahoF(), lookahead = barmerge.lookahead_on)
[d15, a15] = request.security(syminfo.tickerid, "15", divClosed(), lookahead = barmerge.lookahead_on)
[d45, a45] = request.security(syminfo.tickerid, "45", divClosed(), lookahead = barmerge.lookahead_on)
[d60, a60] = request.security(syminfo.tickerid, "60", divClosed(), lookahead = barmerge.lookahead_on)
// P/D aralığı = son onaylı 15m swing tepe ve dip
swF() =>
    ph = ta.pivothigh(high, swLen, swLen)
    pl = ta.pivotlow(low, swLen, swLen)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    // Onaylanmamış son tepe/dip (son swLen+1 bar) da aralığa dahil: kırılımda aralık bayatlamasın
    [math.max(nz(sh, high), ta.highest(high, swLen + 1)), math.min(nz(sl, low), ta.lowest(low, swLen + 1))]
[pdH, pdL] = request.security(syminfo.tickerid, "15", swF(), lookahead = barmerge.lookahead_on)
[pdH1, pdL1] = request.security(syminfo.tickerid, "1", swF())
[pdH5, pdL5] = request.security(syminfo.tickerid, "5", swF())
[b1, s1, bSL1, sSL1, z1_0, z1_1, z1_2, z1_3, z1_4, z1_5, z1_6, z1_7, z1_8, z1_9, z1_10, z1_11, z1_12, z1_13, z1_14, z1_15, z1_16, z1_17] = request.security(syminfo.tickerid, "1",  zonesF())
[b5, s5, bSL5, sSL5, z5_0, z5_1, z5_2, z5_3, z5_4, z5_5, z5_6, z5_7, z5_8, z5_9, z5_10, z5_11, z5_12, z5_13, z5_14, z5_15, z5_16, z5_17] = request.security(syminfo.tickerid, "5",  zonesF())
[b15, s15, bSL15, sSL15, z15_0, z15_1, z15_2, z15_3, z15_4, z15_5, z15_6, z15_7, z15_8, z15_9, z15_10, z15_11, z15_12, z15_13, z15_14, z15_15, z15_16, z15_17] = request.security(syminfo.tickerid, "15", zonesF(), lookahead = barmerge.lookahead_on)

// ICT dönüş: BOS (5m). Kapanış son swing tepesinin üstüne çıkarsa boğa BOS, son swing dibinin altına inerse ayı BOS.
bosF() =>
    ph = ta.pivothigh(high, bosLen, bosLen)
    pl = ta.pivotlow(low, bosLen, bosLen)
    var float lh = na
    var float ll = na
    var int dir = 0
    var int at = na
    var float lvl = na
    if not na(ph)
        lh := ph
    if not na(pl)
        ll := pl
    if not na(lh) and close > lh
        dir := 1
        at := bar_index
        lvl := lh
        lh := na
    if not na(ll) and close < ll
        dir := -1
        at := bar_index
        lvl := ll
        ll := na
    [dir, bar_index - at, lvl]
[bosD, bosA, bosLv] = request.security(syminfo.tickerid, "5", bosF())
bosOk = bosD != 0 and bosA <= bosFresh

vw  = ta.vwap(hlc3)
vwT = touch(vw, 0) or touch(vw, 1) or touch(vw, 2)
atr = ta.atr(14)
var int t0 = time

// Temas yönlü: fiyat seviyenin üstündeyse destek (long tepki), altındaysa direnç (short tepki).
// Önem sırası D > 4H > 1H > VWAP. Temas yoksa yön = taze RSI uyumsuzluğu, o da yoksa premium→short / discount→long.
sideOf(v) => close >= v ? 1 : -1
sdD = sideOf(vD)
sd4 = sideOf(v4)
sd1 = sideOf(v1)
sdV = sideOf(vw)
R  = hD ? sdD : h4 ? sd4 : h1 ? sd1 : vwT ? sdV : 0
// Fiyat swing aralığının dışına taşarsa pos <0 veya >1 olur; yine discount/premium sayılır
pos   = (close - pdL) / (pdH - pdL)
fr0(d, a) => d != 0 and a <= fresh
dv = fr0(d15, a15) ? d15 : fr0(d45, a45) ? d45 : fr0(d60, a60) ? d60 : 0
// Yön = taze BOS yönü (zorunlu). BOS yoksa yön yalnızca gösterim içindir, işlem açılmaz.
T = bosOk ? bosD : R != 0 ? R : dv != 0 ? dv : pos > 0.5 ? -1 : 1
// Temas ancak BOS yönünde tepki veriyorsa sayılır (long için destek, short için direnç)
step2 = R != 0 and R == T
fr(d, a) => d == T and a <= fresh
divOk = fr(d15, a15) or fr(d45, a45) or fr(d60, a60)
// Temanın tepki yönüne ters taze uyumsuzluk varsa (ve aynı yönde yoksa) işlem yok
divOpp   = (fr0(d15, a15) and d15 == -T) or (fr0(d45, a45) and d45 == -T) or (fr0(d60, a60) and d60 == -T)
conflict = divOpp and not divOk

// Likidite seviyeleri: ICT Killzones seans tepe-dipleri (NY saati: Asya 20-00, Londra 02-05, NY AM 09:30-11, Lunch 12-13, PM 13:30-16) ve 5m swing'ler
sessHL(sess) =>
    inS = not na(time(timeframe.period, sess, "America/New_York"))
    var float hi = na
    var float lo = na
    var float lHi = na
    var float lLo = na
    if inS and not inS[1]
        hi := high
        lo := low
    else if inS
        hi := math.max(hi, high)
        lo := math.min(lo, low)
    if not inS and inS[1]
        lHi := hi
        lLo := lo
    [hi, lo, lHi, lLo]
[aH, aL, aH0, aL0] = sessHL("2000-0000")
[lnH, lnL, lnH0, lnL0] = sessHL("0200-0500")
[nyH, nyL, nyH0, nyL0] = sessHL("0930-1100")
[nlH, nlL, nlH0, nlL0] = sessHL("1200-1300")
[npH, npL, npH0, npL0] = sessHL("1330-1600")
var swH = array.new_float()
var swL = array.new_float()
pH5 = ta.pivothigh(high, 5, 5)
pL5 = ta.pivotlow(low, 5, 5)
if not na(pH5)
    array.unshift(swH, pH5)
    if array.size(swH) > 5
        array.pop(swH)
if not na(pL5)
    array.unshift(swL, pL5)
    if array.size(swL) > 5
        array.pop(swL)
lv = array.new_float()
lb = array.new_string()
add(v, n) =>
    if not na(v)
        array.push(lv, v)
        array.push(lb, n)
add(aH, "Asya H")
add(aL, "Asya L")
add(aH0, "Asya H")
add(aL0, "Asya L")
add(lnH, "Londra H")
add(lnL, "Londra L")
add(lnH0, "Londra H")
add(lnL0, "Londra L")
add(nyH, "NYAM H")
add(nyL, "NYAM L")
add(nyH0, "NYAM H")
add(nyL0, "NYAM L")
add(nlH, "NYL H")
add(nlL, "NYL L")
add(nlH0, "NYL H")
add(nlL0, "NYL L")
add(npH, "NYPM H")
add(npL, "NYPM L")
add(npH0, "NYPM H")
add(npL0, "NYPM L")
for v in swH
    add(v, "Swing H")
for v in swL
    add(v, "Swing L")

// Değerli bölge = içinde ya da ±keyTol yakınında likidite seviyesi (seans/swing) veya HAHO/HAOF olan FVG/iFVG/OB.
// Birden fazla değerliyse büyük zaman dilimi öncelikli (15m > 5m > 1m); SL o bölgenin ötesine konur.
keyNear(t, b) =>
    k = (t + b) / 2 * keyTol
    hit = ""
    for [i, v] in lv
        if hit == "" and v >= b - k and v <= t + k
            hit := array.get(lb, i)
    if hit == ""
        hit := v1 >= b - k and v1 <= t + k ? "HAHO 1H" : v4 >= b - k and v4 <= t + k ? "HAHO 4H" : vD >= b - k and vD <= t + k ? "HAHO D" : vw >= b - k and vw <= t + k ? "HAOF" : ""
    hit
cT = array.new_float()
cB = array.new_float()
cN = array.new_string()
pick(t, b, nm) =>
    if not na(t) and low <= t and high >= b
        array.push(cT, t)
        array.push(cB, b)
        array.push(cN, nm)
// 1m → 5m → 15m sırasıyla eklenir; döngüde sonraki (büyük TF) değerli bölge öncekini ezer
if T == 1
    pick(z1_0, z1_1, "1m FVG")
    pick(z1_6, z1_7, "1m iFVG")
    pick(z1_12, z1_13, "1m OB")
    pick(z5_0, z5_1, "5m FVG")
    pick(z5_6, z5_7, "5m iFVG")
    pick(z5_12, z5_13, "5m OB")
    pick(z15_0, z15_1, "15m FVG")
    pick(z15_6, z15_7, "15m iFVG")
    pick(z15_12, z15_13, "15m OB")
else
    pick(z1_3, z1_4, "1m FVG")
    pick(z1_9, z1_10, "1m iFVG")
    pick(z1_15, z1_16, "1m OB")
    pick(z5_3, z5_4, "5m FVG")
    pick(z5_9, z5_10, "5m iFVG")
    pick(z5_15, z5_16, "5m OB")
    pick(z15_3, z15_4, "15m FVG")
    pick(z15_9, z15_10, "15m iFVG")
    pick(z15_15, z15_16, "15m OB")
float zT = na
float zB = na
string zN = ""
for [i, t] in cT
    why = keyNear(t, array.get(cB, i))
    if why != ""
        zT := t
        zB := array.get(cB, i)
        zN := array.get(cN, i) + " @" + why
zone   = zN
zoneOk = zone != ""
zSL    = T == 1 ? zB : zT
// P/D, girişin alınacağı bölgenin TF'indeki swing aralığına göre (bölge yoksa 15m)
pdTF = str.startswith(zN, "1m") ? "1m" : str.startswith(zN, "5m") ? "5m" : "15m"
zH   = pdTF == "1m" ? pdH1 : pdTF == "5m" ? pdH5 : pdH
zL   = pdTF == "1m" ? pdL1 : pdTF == "5m" ? pdL5 : pdL
zPos = (close - zL) / (zH - zL)
pdOk = T == 1 ? zPos < 0.5 : T == -1 ? zPos > 0.5 : false

// Risk: kayıp (komisyon dahil) portföyün riskPct'i; TP net R:R >= minRR
entry = close
// SL bölgenin ötesinde ve en az max(1 ATR(5m), %0.15) uzakta: gürültüde stop olmasın, komisyon riski yutmasın
minD  = math.max(atr, entry * 0.0015)
sl    = T == 1 ? math.min(nz(zSL, entry) - atr * 0.25, entry - minD) : math.max(nz(zSL, entry) + atr * 0.25, entry + minD)
risk  = math.abs(entry - sl)
fee   = entry * feePct * 2
// TP = likidite; 4H trendine ters işlemde en yakın likidite, değilse net R:R ≥ minRR veren en yakın likidite
minDist = minRR * (risk + fee) + fee
counter = t4 == -T
float nearD = na
string nearN = ""
float okD = na
string okN = ""
for [i, v] in lv
    d = (v - entry) * T
    if d > fee
        if na(nearD) or d < nearD
            nearD := d
            nearN := array.get(lb, i)
        if d >= minDist and (na(okD) or d < okD)
            okD := d
            okN := array.get(lb, i)
tpD   = counter ? nearD : okD
tpN   = counter ? nearN : okN
tp    = na(tpD) ? na : entry + T * tpD
liqOk = not na(tpD) and tpD >= minDist
rrNet = na(tpD) ? na : (tpD - fee) / (risk + fee)
qty   = equity * riskPct / (risk + fee)
lev   = qty * entry / equity
// 5 kontrolden ≥3; değerli ICT bölgesi ve R:R ≥ 2 (likidite TP ile) zorunlu
checks = (step2 ? 1 : 0) + (divOk ? 1 : 0) + (pdOk ? 1 : 0) + (zoneOk ? 1 : 0) + (liqOk ? 1 : 0)
setup = bosOk and zoneOk and liqOk and checks >= 3 and not conflict

alertcondition(setup and T == 1,  "LONG kurulum",  "Scalp Panel: LONG kurulum")
alertcondition(setup and T == -1, "SHORT kurulum", "Scalp Panel: SHORT kurulum")

var tb = table.new(position.top_right, 2, 21, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
put(r, k, v, c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)
on(b) => b ? color.lime : color.gray
tl(h, sd) => h ? (sd == 1 ? " ✓ destek" : " ✓ direnç") : ""
divTxt(d, a) => d == 0 ? "-" : (d == 1 ? "Boğa " : "Ayı ") + str.tostring(a) + " bar önce"

if barstate.islast
    put(0,  "SCALP PANEL", syminfo.ticker + "  " + str.format_time(timenow, "HH:mm", "Europe/Istanbul"), color.white)
    put(1,  "Trend D/4H/1H", arrow(tD) + " " + arrow(t4) + " " + arrow(t1) + "  yön " + (T == 1 ? "LONG" : "SHORT"), T == 1 ? color.lime : T == -1 ? color.red : color.gray)
    put(2,  "HAHO 1H", px(v1) + " " + pct(close / v1 - 1) + tl(h1, sd1), on(h1))
    put(3,  "HAHO 4H", px(v4) + " " + pct(close / v4 - 1) + tl(h4, sd4), on(h4))
    put(4,  "HAHO D",  px(vD) + " " + pct(close / vD - 1) + tl(hD, sdD), on(hD))
    put(5,  "HAOF (VWAP)", px(vw) + " " + pct(close / vw - 1) + tl(vwT, sdV), on(vwT))
    put(6,  "RSI uyum. 15m", divTxt(d15, a15), on(fr(d15, a15)))
    put(7,  "RSI uyum. 45m", divTxt(d45, a45), on(fr(d45, a45)))
    put(8,  "RSI uyum. 1H",  divTxt(d60, a60), on(fr(d60, a60)))
    put(9,  "P/D (" + pdTF + " swing)", (zPos > 0.5 ? "Premium " : "Discount ") + str.tostring(zPos * 100, "#") + "%  [" + px(zL) + " – " + px(zH) + "]", on(pdOk))
    put(10, "ICT 1m",  "B:" + b1 + "  S:" + s1, on(T == 1 ? b1 != "" : T == -1 ? s1 != "" : false))
    put(11, "ICT 5m",  "B:" + b5 + "  S:" + s5, on(T == 1 ? b5 != "" : T == -1 ? s5 != "" : false))
    put(12, "ICT 15m", "B:" + b15 + "  S:" + s15, on(T == 1 ? b15 != "" : T == -1 ? s15 != "" : false))
    put(20, "BOS (5m)", bosD == 0 ? "-" : (bosD == 1 ? "Boğa " : "Ayı ") + px(bosLv) + "  " + str.tostring(bosA) + " bar önce" + (bosOk ? "" : " (bayat)"), on(bosOk))
    put(19, "Değerli bölge", zoneOk ? zone : "yok (likiditede bölge yok)", on(zoneOk))
    put(13, "TP likidite", na(tpD) ? "yok" : tpN + " " + px(tp) + "  R:R " + str.tostring(rrNet, "#.#") + (counter ? "  (4H ters → en yakın)" : ""), on(liqOk))
    put(14, "Kontrol", str.tostring(checks) + "/5", checks >= 3 ? color.yellow : color.gray)
    put(15, "SİNYAL", setup ? (T == 1 ? "LONG KUR" : "SHORT KUR") : not bosOk ? "BEKLE (taze BOS yok)" : conflict ? "BEKLE (temas↔uyumsuzluk çelişkisi)" : "BEKLE", setup ? color.yellow : color.gray)
    put(16, "Plan", zoneOk ? "E " + px(entry) + "  SL " + px(sl) + "  TP " + (na(tp) ? "-" : px(tp)) : "-", color.white)
    put(17, "Boyut", zoneOk ? str.tostring(qty, "#.####") + " · $" + str.tostring(qty * entry, "#") + " · " + str.tostring(lev, "#.#") + "x" : "-", color.white)
    put(18, "Veri", str.tostring((time - t0) / 86400000.0, "#.#") + " gün", color.gray)

// Aktif FVG / iFVG / OB kutuları (1m, 5m, 15m). Yeşil/kırmızı = boğa/ayı FVG, mor = iFVG, mavi/turuncu = boğa/ayı OB.
showZ = input.bool(true, "OB/FVG kutularını çiz")
var array<box> zb = array.new<box>()
zbox(t, b, x, col, txt) =>
    if not na(t) and not na(x)
        why = keyNear(t, b)
        star = why != ""
        array.push(zb, box.new(x, t, time, b, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(col, star ? 0 : 60), border_width = star ? 2 : 1, bgcolor = color.new(col, star ? 75 : 93), text = (star ? "★ " : "") + txt + (star ? " @" + why : ""), text_color = color.new(col, star ? 0 : 50), text_size = size.tiny, text_halign = text.align_right))
zset(tf, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17) =>
    zbox(a0, a1, a2, color.lime, tf + " Boğa FVG")
    zbox(a3, a4, a5, color.red, tf + " Ayı FVG")
    zbox(a6, a7, a8, color.purple, tf + " Boğa iFVG")
    zbox(a9, a10, a11, color.fuchsia, tf + " Ayı iFVG")
    zbox(a12, a13, a14, color.aqua, tf + " Boğa OB")
    zbox(a15, a16, a17, color.orange, tf + " Ayı OB")
if barstate.islast and showZ
    for bx in zb
        box.delete(bx)
    array.clear(zb)
    zset("1m", z1_0, z1_1, z1_2, z1_3, z1_4, z1_5, z1_6, z1_7, z1_8, z1_9, z1_10, z1_11, z1_12, z1_13, z1_14, z1_15, z1_16, z1_17)
    zset("5m", z5_0, z5_1, z5_2, z5_3, z5_4, z5_5, z5_6, z5_7, z5_8, z5_9, z5_10, z5_11, z5_12, z5_13, z5_14, z5_15, z5_16, z5_17)
    zset("15m", z15_0, z15_1, z15_2, z15_3, z15_4, z15_5, z15_6, z15_7, z15_8, z15_9, z15_10, z15_11, z15_12, z15_13, z15_14, z15_15, z15_16, z15_17)
