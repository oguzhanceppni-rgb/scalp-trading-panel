//@version=6
indicator("Scalp Panel [Claude]", overlay = true, max_boxes_count = 60, max_labels_count = 500)

equity  = input.float(200,  "Portföy ($)")
riskPct = input.float(3.0,  "İşlem başı max kayıp %") / 100
tpR     = input.float(2.0,  "TP (R katı)")
feePct  = input.float(0.0,  "Taker komisyon % (tek yön)") / 100
vwmaLen = input.int(20,     "HAHO (VWMA) uzunluk")
rsiLen  = input.int(14,     "RSI uzunluk")
pv      = input.int(3,      "Pivot sol/sağ bar")
fresh   = input.int(10,     "Uyumsuzluk tazeliği (o TF'nin barı)")
tol     = input.float(0.05, "Temas toleransı %") / 100
swLen   = input.int(5,      "P/D swing pivot (giriş bölgesinin TF'i, sol/sağ bar)")
keyTol  = input.float(0.10, "Bölge–likidite yakınlık toleransı %") / 100
bosRun  = input.int(3,      "BOS: ardışık ters mum sayısı (min)")
bosFresh = input.int(6,     "BOS tazeliği (5m bar)")
slAtr   = input.float(1.5,  "Min SL (ATR katı)")
yThr    = input.float(0.05, "Faiz hareket eşiği % (son kapanmış 1H mum)")

touch(v, i) => low[i] <= v[i] * (1 + tol) and high[i] >= v[i] * (1 - tol)
inZ(t, b) => not na(t) and low <= t and high >= b
arrow(d) => d == 1 ? "↑" : d == -1 ? "↓" : "→"
pct(x) => (x >= 0 ? "+" : "") + str.tostring(x * 100, "#.##") + "%"
px(x) => str.tostring(x, format.mintick)

// Adım 1 — trend: fiyat > EMA50 > EMA200 (veya tersi)
trendF() =>
    e50  = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    close > e50 and e50 > e200 ? 1 : close < e50 and e50 < e200 ? -1 : 0

// Adım 2 — HAHO (VWMA) teması: bu veya önceki mum
hahoF() =>
    v = ta.vwma(close, vwmaLen)
    [v, touch(v, 0) or touch(v, 1)]

// Adım 3 — klasik RSI uyumsuzluğu (pivot tabanlı)
divF() =>
    r  = ta.rsi(close, rsiLen)
    ph = ta.pivothigh(high, pv, pv)
    pl = ta.pivotlow(low, pv, pv)
    var float pH = na
    var float rH = na
    var float pL = na
    var float rL = na
    var int dir = 0
    var int at = na
    if not na(ph)
        if not na(pH) and ph > pH and r[pv] < rH
            dir := -1
            at := bar_index
        else if dir == -1
            // yeni tepe uyumsuzluk oluşturmadı → eski ayı uyumsuzluğu geçersiz
            dir := 0
        pH := ph
        rH := r[pv]
    if not na(pl)
        if not na(pL) and pl < pL and r[pv] > rL
            dir := 1
            at := bar_index
        else if dir == 1
            // yeni dip uyumsuzluk oluşturmadı → eski boğa uyumsuzluğu geçersiz
            dir := 0
        pL := pl
        rL := r[pv]
    // Fiyat uyumsuzluğun tepesini (dibini) kapanışla aşarsa uyumsuzluk geçersiz
    if dir == -1 and close > pH
        dir := 0
    if dir == 1 and close < pL
        dir := 0
    [dir, bar_index - at]

// Yalnızca kapanmış mumlar: bir önceki (kapanmış) HTF mumundaki durum; yaş şimdiki muma göre +1
divClosed() =>
    [d, a] = divF()
    [d[1], a[1] + 1]

// Adım 4 — ICT: son FVG / IFVG / OB ve fiyat içinde mi
zonesF() =>
    var float bfT = na
    var float bfB = na
    var float sfT = na
    var float sfB = na
    var float biT = na
    var float biB = na
    var float siT = na
    var float siB = na
    var float boT = na
    var float boB = na
    var float soT = na
    var float soB = na
    var int bfX = na
    var int sfX = na
    var int biX = na
    var int siX = na
    var int boX = na
    var int soX = na
    if low > high[2]
        bfT := low
        bfB := high[2]
        bfX := time[2]
        if close[2] < open[2]
            boT := high[2]
            boB := low[2]
            boX := time[2]
    if high < low[2]
        sfT := low[2]
        sfB := high
        sfX := time[2]
        if close[2] > open[2]
            soT := high[2]
            soB := low[2]
            soX := time[2]
    // kapanışla kırılan FVG ters yönde IFVG olur
    if not na(bfB) and close < bfB
        siT := bfT
        siB := bfB
        siX := bfX
        bfT := na
        bfB := na
    if not na(sfT) and close > sfT
        biT := sfT
        biB := sfB
        biX := sfX
        sfT := na
        sfB := na
    if not na(biB) and close < biB
        biT := na
        biB := na
    if not na(siT) and close > siT
        siT := na
        siB := na
    if not na(boB) and close < boB
        boT := na
        boB := na
    if not na(soT) and close > soT
        soT := na
        soB := na
    bull = (inZ(bfT, bfB) ? "FVG " : "") + (inZ(biT, biB) ? "iFVG " : "") + (inZ(boT, boB) ? "OB" : "")
    bear = (inZ(sfT, sfB) ? "FVG " : "") + (inZ(siT, siB) ? "iFVG " : "") + (inZ(soT, soB) ? "OB" : "")
    bSL = math.min(inZ(bfT, bfB) ? bfB : 1e12, inZ(biT, biB) ? biB : 1e12, inZ(boT, boB) ? boB : 1e12)
    sSL = math.max(inZ(sfT, sfB) ? sfT : 0.0, inZ(siT, siB) ? siT : 0.0, inZ(soT, soB) ? soT : 0.0)
    [bull, bear, bSL, sSL, bfT, bfB, bfX, sfT, sfB, sfX, biT, biB, biX, siT, siB, siX, boT, boB, boX, soT, soB, soX]

// lookahead_on: son barda oluşan (canlı) HTF mumu okunur. Panel yalnızca son barı kullanır, geçmiş barlar önemsiz.
t1 = request.security(syminfo.tickerid, "60",  trendF(), lookahead = barmerge.lookahead_on)
t4 = request.security(syminfo.tickerid, "240", trendF(), lookahead = barmerge.lookahead_on)
tD = request.security(syminfo.tickerid, "D",   trendF(), lookahead = barmerge.lookahead_on)
[v1, h1] = request.security(syminfo.tickerid, "60",  hahoF(), lookahead = barmerge.lookahead_on)
[v4, h4] = request.security(syminfo.tickerid, "240", hahoF(), lookahead = barmerge.lookahead_on)
[vD, hD] = request.security(syminfo.tickerid, "D",   hahoF(), lookahead = barmerge.lookahead_on)
// bias: son KAPANMIŞ 4H mumunun VWMA20'si (backtest ile aynı, repaint yok)
hahoC() => ta.vwma(close, vwmaLen)[1]
v1c = request.security(syminfo.tickerid, "60",  hahoC(), lookahead = barmerge.lookahead_on)
vDc = request.security(syminfo.tickerid, "D",   hahoC(), lookahead = barmerge.lookahead_on)
v4c = request.security(syminfo.tickerid, "240", ta.vwma(close, vwmaLen)[1], lookahead = barmerge.lookahead_on)
// 4H bias (kullanıcı, 21.10): son KAPANMIŞ 4H mumun gövde kapanışı 4H VWAP20'nin (hlc3×hacim, 20 mum) üstünde → LONG, altında → SHORT.
// Hacim yoksa (faizler) hlc3'ün 20 mumluk ortalaması.
biasF() =>
    sv = math.sum(volume, 20)
    spv = math.sum(hlc3 * volume, 20)
    sm = ta.sma(hlc3, 20)
    vw20 = sv > 0 ? spv / sv : sm
    b = close > vw20 ? 1 : close < vw20 ? -1 : 0
    [b[1], vw20[1], close[1]]
[b4, b4v, b4c] = request.security(syminfo.tickerid, "240", biasF(), lookahead = barmerge.lookahead_on)
[b1h, b1v, b1c] = request.security(syminfo.tickerid, "60", biasF(), lookahead = barmerge.lookahead_on)
// 23.10 test: emtia (XAU/XAG) kendi bias'ı 1H'de, endeksler 4H'de daha iyi
cmdB = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG")
bB  = cmdB ? b1h : b4
bBv = cmdB ? b1v : b4v
bBc = cmdB ? b1c : b4c
bTF = cmdB ? "1H" : "4H"
[y10b, y10v, y10c] = request.security("TVC:US10Y", "60", biasF(), lookahead = barmerge.lookahead_on)
[y02b, y02v, y02c] = request.security("TVC:US02Y", "60", biasF(), lookahead = barmerge.lookahead_on)
[d15, a15] = request.security(syminfo.tickerid, "15", divClosed(), lookahead = barmerge.lookahead_on)
[d45, a45] = request.security(syminfo.tickerid, "45", divClosed(), lookahead = barmerge.lookahead_on)
[d60, a60] = request.security(syminfo.tickerid, "60", divClosed(), lookahead = barmerge.lookahead_on)
// P/D aralığı = son onaylı 15m swing tepe ve dip
swF() =>
    ph = ta.pivothigh(high, swLen, swLen)
    pl = ta.pivotlow(low, swLen, swLen)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    // Onaylanmamış son tepe/dip (son swLen+1 bar) da aralığa dahil: kırılımda aralık bayatlamasın
    [math.max(nz(sh, high), ta.highest(high, swLen + 1)), math.min(nz(sl, low), ta.lowest(low, swLen + 1))]
[pdH, pdL] = request.security(syminfo.tickerid, "15", swF(), lookahead = barmerge.lookahead_on)
[pdH5, pdL5] = request.security(syminfo.tickerid, "5", swF())
[b5, s5, bSL5, sSL5, z5_0, z5_1, z5_2, z5_3, z5_4, z5_5, z5_6, z5_7, z5_8, z5_9, z5_10, z5_11, z5_12, z5_13, z5_14, z5_15, z5_16, z5_17] = request.security(syminfo.tickerid, "5",  zonesF())
[b15, s15, bSL15, sSL15, z15_0, z15_1, z15_2, z15_3, z15_4, z15_5, z15_6, z15_7, z15_8, z15_9, z15_10, z15_11, z15_12, z15_13, z15_14, z15_15, z15_16, z15_17] = request.security(syminfo.tickerid, "15", zonesF(), lookahead = barmerge.lookahead_on)

// Kullanıcı BOS'u (5m): ard arda ≥bosRun düşüş mumu dizisinin ilk mumunun açılışı üstünde kapanış → boğa BOS; tersi ayı BOS.
bosF() =>
    var float dnS = na
    var float upS = na
    var int rd = 0
    var int rl = 0
    var float ro = na
    var int dir = 0
    var int at = na
    var float lvl = na
    if not na(dnS) and close > dnS
        dir := 1
        at := bar_index
        lvl := dnS
        dnS := na
    if not na(upS) and close < upS
        dir := -1
        at := bar_index
        lvl := upS
        upS := na
    cd = close > open ? 1 : close < open ? -1 : 0
    if cd != 0 and cd == rd
        rl += 1
    else
        rd := cd
        rl := 1
        ro := open
    if rl >= bosRun
        if rd == -1
            dnS := ro
        else if rd == 1
            upS := ro
    [dir, bar_index - at, lvl]
[bosD, bosA, bosLv] = request.security(syminfo.tickerid, "5", bosF())
bosOk = bosD != 0 and bosA <= bosFresh

vw  = ta.vwap(hlc3, ta.change(dayofmonth(time, "Europe/Istanbul")) != 0)
vwT = touch(vw, 0) or touch(vw, 1)
t5(v) => (low <= v * (1 + tol) and high >= v * (1 - tol)) or (low[1] <= v[1] * (1 + tol) and high[1] >= v[1] * (1 - tol))
hT1 = t5(v1c)
hT4 = t5(v4c)
hTD = t5(vDc)
atr = ta.atr(14)
var int t0 = time

// Temas yönlü: fiyat seviyenin üstündeyse destek (long tepki), altındaysa direnç (short tepki).
// Önem sırası D > 4H > 1H > VWAP. Temas yoksa yön = taze RSI uyumsuzluğu, o da yoksa premium→short / discount→long.
sideOf(v) => close >= v ? 1 : -1
sdD = sideOf(vD)
sd4 = sideOf(v4)
sd1 = sideOf(v1)
sdV = sideOf(vw)
R  = hD ? sdD : h4 ? sd4 : h1 ? sd1 : vwT ? sdV : 0
// Fiyat swing aralığının dışına taşarsa pos <0 veya >1 olur; yine discount/premium sayılır
pos   = (close - pdL) / (pdH - pdL)
fr0(d, a) => d != 0 and a <= fresh
dv = fr0(d15, a15) ? d15 : fr0(d45, a45) ? d45 : fr0(d60, a60) ? d60 : 0
// Yön = 4H bias (kapanmış 4H gövde kapanışı vs 4H VWAP20).
// Giriş: aynı yönde taze kullanıcı BOS'u + o yönde 5m bölge içinde + puan ≥1 (RSI uyumsuzluğu / HAHO-HAOF teması / P/D).
T = bB >= 0 ? 1 : -1
divOk = dv == T
zone   = T == 1 ? b5 : s5
zoneOk = zone != ""
zSL    = T == 1 ? bSL5 : sSL5
pdTF = "5m"
zH   = pdH5
zL   = pdL5
zPos = (close - zL) / (zH - zL)
pdOk = T == 1 ? zPos < 0.5 : zPos > 0.5
tchOk = hT1 or hT4 or hTD or vwT
score = (divOk ? 1 : 0) + (tchOk ? 1 : 0) + (pdOk ? 1 : 0)
bosOk2 = bosOk and bosD == T
// ZORUNLU (kullanıcı kuralı 21.10): XAU/XAG faizle ters korele işlem alır.
// US10Y ve US02Y son KAPANMIŞ 1H mumunun değişimi (21.10 test: 4 saatlik pencereden iyi); ikisinden hiçbiri işlem yönüyle aynı yönde olmayacak, en az biri ters yönde olacak.
y10 = y10b
y02 = y02b
isCmd = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG")
// Emtia, faizin (10Y ve 2Y aynı yönde) 1H bias'ının (23.10 test: 4H'den iyi) TERSİNE işlem alır; faiz bias'ları ayrışırsa emtiada işlem yok.
macroOk = not isCmd or (y10b == y02b and y10b == -T)

// Risk: kayıp (komisyon dahil) portföyün riskPct'i; TP = tpR × risk (20.10 backtest: sabit 3R)
entry = close
// SL bölgenin 0.25 ATR ötesinde ve en az slAtr × ATR(5m) uzakta
minD  = atr * slAtr
sl    = T == 1 ? math.min(nz(zSL, entry) - atr * 0.25, entry - minD) : math.max(nz(zSL, entry) + atr * 0.25, entry + minD)
risk  = math.abs(entry - sl)
fee   = entry * feePct * 2
tp    = entry + T * tpR * (risk + fee)
rrNet = tpR
qty   = equity * riskPct / (risk + fee)
lev   = qty * entry / equity
// Üçü zorunlu: 4H yönünde taze BOS + o yönde 5m bölge + puan ≥1
checks = (bosOk2 ? 1 : 0) + (zoneOk ? 1 : 0) + (score >= 1 ? 1 : 0)
setup = checks == 3 and macroOk

// Canlı mum yok sayılır: sinyal son 1–2 KAPANMIŞ 5m mumdan (tarama 10 dk'da bir). Giriş şimdiki fiyat, SL sinyal mumundan, TP = tpR × yeni risk.
sK   = setup[1] ? 1 : setup[2] ? 2 : 0
sT   = sK == 1 ? T[1] : sK == 2 ? T[2] : 0
sSL  = sK == 1 ? sl[1] : sK == 2 ? sl[2] : na
sRsk = sT * (entry - sSL)
sOk  = sK > 0 and sRsk > 0
sTP  = entry + sT * tpR * sRsk
sQty = equity * riskPct / sRsk
sLev = sQty * entry / equity
alertcondition(sOk and sT == 1,  "LONG kurulum",  "Scalp Panel: LONG kurulum")
alertcondition(sOk and sT == -1, "SHORT kurulum", "Scalp Panel: SHORT kurulum")
// Doğrulama: geçmiş sinyaller (kapanmış mum, seans içi) etiket olarak — backtest sinyalleriyle karşılaştırmak için
showSig = input.bool(false, "Geçmiş sinyal etiketleri (16:20–19:00, yalnız doğrulama için; paneli yavaşlatır)")
hmI = hour(time, "Europe/Istanbul") * 60 + minute(time, "Europe/Istanbul")
if showSig and barstate.isconfirmed and setup and hmI >= 980 and hmI < 1140 and dayofweek(time, "Europe/Istanbul") != dayofweek.saturday and dayofweek(time, "Europe/Istanbul") != dayofweek.sunday
    label.new(bar_index, T == 1 ? low : high, "SIG " + (T == 1 ? "L " : "S ") + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Istanbul"), style = T == 1 ? label.style_label_up : label.style_label_down, color = color.new(T == 1 ? color.lime : color.red, 30), textcolor = color.white, size = size.tiny)

var tb = table.new(position.top_right, 2, 22, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
put(r, k, v, c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)
on(b) => b ? color.lime : color.gray
tl(h, sd) => h ? (sd == 1 ? " ✓ destek" : " ✓ direnç") : ""
divTxt(d, a) => d == 0 ? "-" : (d == 1 ? "Boğa " : "Ayı ") + str.tostring(a) + " bar önce"

kTxt = str.tostring(checks) + "/3 (BOS · 5m bölge · puan " + str.tostring(score) + ": uyum " + (divOk ? "✓" : "✗") + " temas " + (tchOk ? "✓" : "✗") + " P/D " + (pdOk ? "✓" : "✗") + ")"
bTxt = checks == 3 ? "BEKLE (faiz ters korele değil)" : not bosOk2 ? "BEKLE (bias yönünde taze BOS yok)" : not zoneOk ? "BEKLE (5m bölge yok)" : "BEKLE (puan 0)"
bs(b) => b == 1 ? "↑" : b == -1 ? "↓" : "→"
if barstate.islast
    put(0,  "SCALP PANEL", syminfo.ticker + "  " + str.format_time(timenow, "HH:mm", "Europe/Istanbul"), color.white)
    put(1,  "Trend D/4H/1H", arrow(tD) + " " + arrow(t4) + " " + arrow(t1) + "  " + bTF + " bias " + (T == 1 ? "LONG" : "SHORT") + " (" + bTF + " kapanış " + px(bBc) + (bB >= 0 ? " > " : " < ") + "VWAP20 " + px(bBv) + ")", T == 1 ? color.lime : T == -1 ? color.red : color.gray)
    put(2,  "HAHO 1H", px(v1) + " " + pct(close / v1 - 1) + tl(hT1, sd1), on(hT1))
    put(3,  "HAHO 4H", px(v4) + " " + pct(close / v4 - 1) + tl(hT4, sd4), on(hT4))
    put(4,  "HAHO D",  px(vD) + " " + pct(close / vD - 1) + tl(hTD, sdD), on(hTD))
    put(5,  "HAOF (VWAP)", px(vw) + " " + pct(close / vw - 1) + tl(vwT, sdV), on(vwT))
    put(6,  "RSI uyum. 15m", divTxt(d15, a15), on(fr0(d15, a15)))
    put(7,  "RSI uyum. 45m", divTxt(d45, a45), on(fr0(d45, a45)))
    put(8,  "RSI uyum. 1H",  divTxt(d60, a60), on(fr0(d60, a60)))
    put(9,  "P/D (" + pdTF + " swing)", (zPos > 0.5 ? "Premium " : "Discount ") + str.tostring(zPos * 100, "#") + "%  [" + px(zL) + " – " + px(zH) + "]", on(pdOk))
    put(10, "ICT 1m",  "kapalı (panel hafifletildi 23.10)", color.gray)
    put(11, "ICT 5m",  "B:" + b5 + "  S:" + s5, on(T == 1 ? b5 != "" : T == -1 ? s5 != "" : false))
    put(12, "ICT 15m", "B:" + b15 + "  S:" + s15, on(T == 1 ? b15 != "" : T == -1 ? s15 != "" : false))
    put(20, "BOS (5m, ≥" + str.tostring(bosRun) + " mum)", bosD == 0 ? "-" : (bosD == 1 ? "Boğa " : "Ayı ") + px(bosLv) + " " + str.tostring(bosA) + " bar önce" + (bosOk ? (bosD == T ? "" : " (bias ters)") : " (bayat)"), on(bosOk2))
    put(19, "Değerli bölge", zoneOk ? zone : "yok (yön tarafında 5m bölge yok)", on(zoneOk))
    put(13, "TP", px(tp) + " (" + str.tostring(tpR, "#.#") + "R)", color.white)
    put(14, "Kontrol (kapanmış mum)", kTxt[1], checks[1] == 3 ? color.yellow : color.gray)
    put(15, "SİNYAL", sOk ? (sT == 1 ? "LONG KUR" : "SHORT KUR") + " (" + str.tostring(sK) + " mum önce kapanan)" : sK > 0 ? "BEKLE (fiyat sinyal SL'inin ötesinde)" : bTxt[1], sOk ? color.yellow : color.gray)
    put(16, "Plan", sOk ? "E " + px(entry) + " SL " + px(sSL) + " TP " + px(sTP) : "-", color.white)
    put(17, "Boyut", sOk ? str.tostring(sQty, "#.####") + " · $" + str.tostring(sQty * entry, "#") + " · " + str.tostring(sLev, "#.#") + "x" : "-", color.white)
    put(21, "Faiz 1H bias 10Y/2Y", bs(y10b) + " / " + bs(y02b) + (isCmd ? (macroOk ? "  ✓ emtia " + (T == 1 ? "LONG" : "SHORT") + " serbest" : y10b != y02b ? "  ✗ faizler ayrışıyor" : "  ✗ faiz " + (y10b == 1 ? "↑ → yalnız SHORT" : "↓ → yalnız LONG")) : "  (endeks: filtre yok)"), isCmd ? on(macroOk) : color.gray)
    put(18, "Veri", str.tostring((time - t0) / 86400000.0, "#.#") + " gün", color.gray)

// Aktif FVG / iFVG / OB kutuları (1m, 5m, 15m). Yeşil/kırmızı = boğa/ayı FVG, mor = iFVG, mavi/turuncu = boğa/ayı OB.
showZ = input.bool(true, "OB/FVG kutularını çiz")
// ★ = VWAP'a yakın bölge (yalnızca görsel, 21.10 itibarıyla filtre değil)
vwNear(t, b) =>
    k = (t + b) / 2 * keyTol
    vw >= b - k and vw <= t + k
var array<box> zb = array.new<box>()
zbox(t, b, x, col, txt) =>
    if not na(t) and not na(x)
        star = vwNear(t, b)
        why = "VWAP"
        array.push(zb, box.new(x, t, time, b, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(col, star ? 0 : 60), border_width = star ? 2 : 1, bgcolor = color.new(col, star ? 75 : 93), text = (star ? "★ " : "") + txt + (star ? " @" + why : ""), text_color = color.new(col, star ? 0 : 50), text_size = size.tiny, text_halign = text.align_right))
zset(tf, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17) =>
    zbox(a0, a1, a2, color.lime, tf + " Boğa FVG")
    zbox(a3, a4, a5, color.red, tf + " Ayı FVG")
    zbox(a6, a7, a8, color.purple, tf + " Boğa iFVG")
    zbox(a9, a10, a11, color.fuchsia, tf + " Ayı iFVG")
    zbox(a12, a13, a14, color.aqua, tf + " Boğa OB")
    zbox(a15, a16, a17, color.orange, tf + " Ayı OB")
if barstate.islast and showZ
    for bx in zb
        box.delete(bx)
    array.clear(zb)
    zset("5m", z5_0, z5_1, z5_2, z5_3, z5_4, z5_5, z5_6, z5_7, z5_8, z5_9, z5_10, z5_11, z5_12, z5_13, z5_14, z5_15, z5_16, z5_17)
    zset("15m", z15_0, z15_1, z15_2, z15_3, z15_4, z15_5, z15_6, z15_7, z15_8, z15_9, z15_10, z15_11, z15_12, z15_13, z15_14, z15_15, z15_16, z15_17)
